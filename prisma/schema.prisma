datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String          @id @default(uuid())
  email        String          @unique
  passwordHash String
  role         String          @default("STUDENT") // STUDENT, ADMIN
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  profile          StudentProfile?
  practiceAttempts PracticeAttempt[]
  testAttempts     TestAttempt[]
  progressRecords  Progress[]
  notifications    Notification[]
  aiConversations  AIConversation[]

  @@index([email])
}

model StudentProfile {
  id         String   @id @default(uuid())
  userId     String   @unique
  fullName   String
  avatarUrl  String?
  gradeClass String   @default("Class 8") // "Class 8"
  streakDays Int      @default(1)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ClassLevel {
  id        String   @id @default(uuid())
  name      String   @unique // "Class 5", "Class 6", "Class 7", "Class 8", "Class 9", "Class 10"
  order     Int
  chapters  Chapter[]
  tests     Test[]
  createdAt DateTime @default(now())
}

model Subject {
  id          String    @id @default(uuid())
  slug        String    @unique // "physics", "chemistry", "mathematics", "biology"
  name        String    // "Physics", "Chemistry", "Mathematics", "Biology"
  description String
  accentColor String    // "blue", "green", "orange", "pink"
  icon        String    // Icon key
  order       Int
  chapters    Chapter[]
  tests       Test[]
  progress    Progress[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Chapter {
  id           String          @id @default(uuid())
  subjectId    String
  classLevelId String?
  title        String
  description  String
  order        Int
  lessons      Lesson[]
  video        VideoResource?
  questions    Question[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  subject    Subject     @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  classLevel ClassLevel? @relation(fields: [classLevelId], references: [id], onDelete: SetNull)

  @@index([subjectId])
}

model Lesson {
  id            String   @id @default(uuid())
  chapterId     String
  title         String
  order         Int
  objective     String
  simpleContent String
  workedExample String
  keyPoints     String   // JSON string of key points
  quickQuiz     String   // JSON string of quiz questions
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  chapter Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@index([chapterId])
}

model VideoResource {
  id                      String   @id @default(uuid())
  chapterId               String   @unique
  title                   String
  provider                String   @default("youtube") // youtube, vimeo, demo
  embedUrl                String
  thumbnailUrl            String?
  duration                String   // "12:45"
  licenseOrAuthorization  String   @default("Authorized Educational Embed / CC-BY")
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  chapter Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)
}

model Question {
  id            String   @id @default(uuid())
  chapterId     String
  questionText  String
  options       String   // JSON array of strings
  correctOption Int      // 0, 1, 2, 3
  explanation   String
  difficulty    String   @default("Medium") // Easy, Medium, Hard
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  chapter          Chapter           @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  practiceAttempts PracticeAttempt[]
  testQuestions    TestQuestion[]

  @@index([chapterId])
}

model PracticeAttempt {
  id             String   @id @default(uuid())
  userId         String
  questionId     String
  selectedOption Int
  isCorrect      Boolean
  createdAt      DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([questionId])
}

model Test {
  id            String   @id @default(uuid())
  subjectId     String
  classLevelId  String?
  title         String
  description   String
  durationMin   Int      @default(20) // in minutes
  totalMarks    Int      @default(10)
  passMarks     Int      @default(5)
  isPublished   Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  subject       Subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  classLevel    ClassLevel?    @relation(fields: [classLevelId], references: [id], onDelete: SetNull)
  testQuestions TestQuestion[]
  attempts      TestAttempt[]

  @@index([subjectId])
}

model TestQuestion {
  id         String @id @default(uuid())
  testId     String
  questionId String
  order      Int

  test     Test     @relation(fields: [testId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([testId, questionId])
  @@index([testId])
}

model TestAttempt {
  id          String       @id @default(uuid())
  userId      String
  testId      String
  startedAt   DateTime     @default(now())
  completedAt DateTime?
  score       Int          @default(0)
  totalScore  Int          @default(0)
  passed      Boolean      @default(false)
  answers     TestAnswer[]

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  test Test @relation(fields: [testId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([testId])
}

model TestAnswer {
  id             String  @id @default(uuid())
  attemptId      String
  questionId     String
  selectedOption Int?
  isCorrect      Boolean @default(false)

  attempt TestAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@index([attemptId])
}

model Progress {
  id                String   @id @default(uuid())
  userId            String
  subjectId         String
  percentage        Int      @default(0) // 0 - 100
  completedLessons  String   @default("[]") // JSON string of lesson IDs
  lastActivityAt    DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([userId, subjectId])
  @@index([userId])
  @@index([subjectId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  type      String   @default("info") // info, success, warning, test
  isRead    Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AIConversation {
  id        String      @id @default(uuid())
  userId    String
  title     String      @default("Tutor Session")
  messages  AIMessage[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AIMessage {
  id             String   @id @default(uuid())
  conversationId String
  sender         String   // "user" or "assistant"
  text           String
  createdAt      DateTime @default(now())

  conversation AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}
