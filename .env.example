# Database Configuration
# Local SQLite default (or PostgreSQL: postgresql://USER:PASSWORD@localhost:5432/edubridge?schema=public)
DATABASE_URL="file:./dev.db"

# AI Tutor API Key (Never expose to frontend, never commit to git)
AI_API_KEY="your_ai_api_key"
AI_MODEL="gemini-1.5-flash"

# Session Secret (Generate a 32+ character random string for production)
SESSION_SECRET="generate_a_long_random_secret_at_least_32_characters_long"

# Application Port
PORT=3000
